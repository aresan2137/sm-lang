
$$(

#include <string>
#include <vector>
#include <iostream>
#include <fstream>
#include <map>
#include <sstream>
#include <variant>
#include <cstdlib>

#include "code/json.hpp"
using json = nlohmann::json;

enum class TokenType {
	KEY,
	CPP_BLOCK,
	NUMBER,
	STRING,
	SCOPE,
	SYMBOL,
	ASSIGN,
	MEMBER,
	BRACKET,
	SEMICOLON,
	COMMA,
	VALUE
};

struct Token {
	std::string value;
	TokenType type;
	int line;
};

TokenType GetTypeFromString(const std::string& typeStr) {
	static const std::map<std::string, TokenType> typeMap = {
		{"KEY",TokenType::KEY},
		{"CPP_BLOCK",TokenType::CPP_BLOCK},
		{"NUMBER",TokenType::NUMBER},
		{"STRING",TokenType::STRING},
		{"SCOPE",TokenType::SCOPE},
		{"SYMBOL",TokenType::SYMBOL},
		{"ASSIGN",TokenType::ASSIGN},
		{"MEMBER",TokenType::MEMBER},
		{"BRACKET",TokenType::BRACKET},
		{"SEMICOLON",TokenType::SEMICOLON},
		{"COMMA",TokenType::COMMA},
		{"VALUE",TokenType::VALUE}
	};

	auto it = typeMap.find(typeStr);
	if (it != typeMap.end()) {
		return it->second;
	}

	error("Unknown token type: " + typeStr);

	return TokenType::VALUE; 
}


)$$


func arr<Token> tokenize(str FileName) {
    var str command = "python assets/lexer.py " + FileName;
    var i32 out = sysCall(command);

    if (out != 0) {
        error("Lexer has errored");
    }

    var str jsonFile = load("assets/in.json"); 
    var nlohmann::json data = nlohmann::json::parse(jsonFile);

    var arr<Token> tokens;
    
    if (data.is_array()) {
        var i32 i = 0;
        while (data.size() > i) { 
            var Token t;
            var nlohmann::json item = data[i]; 
            t.value = item.value("value", "");
            t.line = item.value("line", 0);

            var str typeStr = item.value("type", "");
            t.type = GetTypeFromString(typeStr);

            tokens.push_back(t);

            i++;
        }
    }

    print("Loaded " .. tokens.size() .. " tokens.");
    ret tokens;
}